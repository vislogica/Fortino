@page "/lab/ch11/vulnerable/my-invoices"
@attribute [Authorize(Policy = Policies.Customer)]
@using Fortino.Web.Chapters.Ch11.Vulnerable
@inject PortalUserContext Current
@inject MyInvoicesService Invoices

@* VERSIONE VULNERABILE (caso 11.1). Aprila con due clienti diversi in due browser. *@
<PageTitle>Le mie fatture · versione vulnerabile</PageTitle>
<MudText Typo="Typo.h5">Le mie fatture</MudText>
<MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-4">Capitolo 11, caso 11.1 · versione vulnerabile</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
    Utente collegato: <b>@_user</b>. Il servizio crede che il cliente sia: <b>@Current.CustomerName</b>.
</MudAlert>
<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="LoadAsync"
           StartIcon="@Icons.Material.Filled.Refresh">Aggiorna</MudButton>
<InvoiceGrid Items="_invoices" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<Invoice> _invoices = [];
    private string _user = "";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _user = user.GetDisplayName();
        Current.SetUser(user);      // il servizio ricorda il cliente... per tutti
        await LoadAsync();
    }

    private async Task LoadAsync() => _invoices = await Invoices.GetAsync();
}
