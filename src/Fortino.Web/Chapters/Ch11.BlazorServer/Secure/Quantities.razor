@page "/lab/ch11/secure/quantities"
@attribute [Authorize(Policy = Policies.Customer)]
@implements IDisposable
@inject DbConnectionFactory Factory
@inject IJSRuntime JS

@* VERSIONE CORRETTA (caso 11.2). *@
<PageTitle>Quantità · versione corretta</PageTitle>
<MudText Typo="Typo.h5">I miei ordini in bozza</MudText>
<MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-4">Capitolo 11, caso 11.2 · versione corretta</MudText>

<QuantityTable Lines="_lines" OnReload="LoadAsync" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<DraftLine> _lines = [];
    private int? _customerId;
    private DotNetObjectReference<Secure.QuantityEditor>? _editor;
    private DotNetObjectReference<Quantities>? _page;

    protected override async Task OnInitializedAsync()
    {
        _customerId = (await AuthState).User.GetCustomerId();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _customerId is not int id) return;
        // Il cliente si passa all'oggetto qui, sul server: il browser non lo può cambiare.
        _editor = DotNetObjectReference.Create(new Secure.QuantityEditor(Factory, id));
        _page = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("fortinoCh11.register", _editor, _page);
    }

    // Il cursore, dopo ogni modifica, fa rileggere la tabella: si vede subito la quantità nel database.
    [JSInvokable]
    public async Task Reload()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync() =>
        _lines = _customerId is int id ? await DraftLines.ForCustomerAsync(Factory, id) : [];

    public void Dispose()
    {
        _editor?.Dispose();
        _page?.Dispose();
    }
}
