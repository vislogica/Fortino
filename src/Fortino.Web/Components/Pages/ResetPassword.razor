@page "/reset-password"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout

@* La pagina vera di Fortino dove porta il link dell'email di reset (caso 15.2). Nel Laboratorio la
   password non si cambia davvero: serve solo a far vedere dove arriva un link sano. *@

<PageTitle>Reimposta la password · Fortino</PageTitle>

<div class="fortino-login">
    <MudPaper Class="pa-8" Elevation="2" Style="width:420px">
        <MudText Typo="Typo.h5" Class="mb-1"><b>Reimposta la password</b></MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Sei sul sito vero di Fortino: il codice dell'email è arrivato qui.</MudText>
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">
            Codice ricevuto da Fortino. In un'applicazione vera qui sceglieresti la nuova password;
            nel Laboratorio la password non si cambia.
        </MudAlert>
        <MudButton Href="/login" Variant="Variant.Text" Size="Size.Small" Class="px-0">Torna all'accesso</MudButton>
    </MudPaper>
</div>
