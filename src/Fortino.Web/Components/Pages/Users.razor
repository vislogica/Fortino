@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject UserStore UserStore

@* Gli utenti di Fortino, riservati agli amministratori. Qui si disattiva un utente: è il primo
   passo del caso 3.2 del Laboratorio (capitolo 3). Qui si aggiunge un utente (caso 12.1) e si
   manda il codice di reset della password agli utenti spuntati (caso 12.2). *@

<PageTitle>Utenti · Fortino</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Utenti</MudText>

<ActionOutcome Outcome="@Outcome" Error="@Error" SuccessText="Utente aggiunto." />
@if (Sent is not null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
        Codice di reset inviato a @Sent utenti. Le email sono nella «Posta finta».
    </MudAlert>
}

<MudSimpleTable Dense="true" Outlined="true" Elevation="0">
    <thead>
        <tr><th style="width:40px"></th><th>Nome</th><th>Nome utente</th><th>Ruolo</th><th>Stato</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var user in _users)
        {
            <tr>
                <td>
                    <input type="checkbox" name="UserIds" value="@user.Id" form="reset-form"
                           aria-label="@($"Seleziona {user.Username}")" />
                </td>
                <td>@user.DisplayName</td>
                <td>@user.Username</td>
                <td>@Labels.Role(user.Role)</td>
                <td>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(user.IsActive ? Color.Success : Color.Default)">
                        @(user.IsActive ? "Attivo" : "Disattivato")
                    </MudChip>
                </td>
                <td style="text-align:right">
                    @if (user.Id != _currentUserId)
                    {
                        <form method="post" action="@($"/users/{user.Id}/attivo")" class="fortino-menu-form">
                            <AntiforgeryToken />
                            <input type="hidden" name="IsActive" value="@(user.IsActive ? "false" : "true")" />
                            <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Outlined"
                                       Color="@(user.IsActive ? Color.Error : Color.Primary)">
                                @(user.IsActive ? "Disattiva" : "Riattiva")
                            </MudButton>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@* Il modulo dei codici di reset: le caselle spuntate nella tabella gli appartengono (attributo form). *@
<form id="reset-form" method="post" action="/users/reset-password" class="mt-3">
    <AntiforgeryToken />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
        Invia il codice di reset agli utenti selezionati
    </MudButton>
</form>

<MudPaper Outlined="true" Class="pa-4 mt-6" Style="max-width:900px">
    <MudText Typo="Typo.h6" Class="mb-3">Aggiungi un utente</MudText>
    <form method="post" action="/users/nuovo" class="d-flex align-end" style="gap:12px">
        <AntiforgeryToken />
        <div style="flex:1">
            <label for="new-username" class="mud-typography-body2">Nome utente</label>
            <input class="fortino-input" id="new-username" name="Username" required />
        </div>
        <div style="flex:1">
            <label for="new-name" class="mud-typography-body2">Nome e cognome</label>
            <input class="fortino-input" id="new-name" name="DisplayName" />
        </div>
        <div style="flex:1">
            <label for="new-password" class="mud-typography-body2">Password</label>
            <input class="fortino-input" id="new-password" name="Password" type="password" required />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Aggiungi</MudButton>
    </form>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Il nuovo utente è un operatore.</MudText>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "esito")] public string? Outcome { get; set; }
    [SupplyParameterFromQuery(Name = "errore")] public string? Error { get; set; }
    // Quanti codici di reset sono appena partiti (caso 12.2).
    [SupplyParameterFromQuery(Name = "inviati")] public string? Sent { get; set; }

    private IReadOnlyList<AppUser> _users = [];
    private int? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = (await AuthState).User.GetUserId();
        _users = await UserStore.GetAllAsync();
    }
}
