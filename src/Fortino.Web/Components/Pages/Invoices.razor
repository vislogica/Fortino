@page "/invoices"
@attribute [Authorize(Policy = Policies.Staff)]
@inject FortinoQueries Queries

<PageTitle>Fatture · Fortino</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Fatture</MudText>

<InvoiceGrid Items="_items" ShowCustomer="true" />

@code {
    private IReadOnlyList<Invoice> _items = [];

    protected override async Task OnInitializedAsync() => _items = await Queries.GetInvoicesAsync();
}
