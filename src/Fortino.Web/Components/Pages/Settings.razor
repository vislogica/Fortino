@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@inject FortinoQueries Queries

@* Le impostazioni dell'azienda, riservate agli amministratori. Cambiare l'IBAN è il passo
   centrale del caso 7.2 del Laboratorio (capitolo 7): poi si guardano le fatture già emesse. *@

<PageTitle>Impostazioni · Fortino</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Impostazioni dell'azienda</MudText>

<ActionOutcome Outcome="@Outcome" Error="@Error" SuccessText="IBAN aziendale aggiornato." />

@if (_settings is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Outlined="true" Class="pa-4">
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td style="width:180px"><b>Ragione sociale</b></td><td>@_settings.CompanyName</td></tr>
                <tr><td><b>IBAN su cui pagare</b></td><td><code>@_settings.PaymentIban</code></td></tr>
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">
            È l'IBAN che compare sulle fatture emesse da oggi in poi.
        </MudText>

        <form method="post" action="/settings/iban" class="mt-4" style="max-width:480px">
            <AntiforgeryToken />
            <label for="iban" class="mud-typography-body2">Nuovo IBAN su cui pagare</label>
            <input class="fortino-input" id="iban" name="Iban" value="@_settings.PaymentIban" required />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Salva l'IBAN</MudButton>
        </form>
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery(Name = "esito")] public string? Outcome { get; set; }
    [SupplyParameterFromQuery(Name = "errore")] public string? Error { get; set; }

    private CompanySettings? _settings;

    protected override async Task OnInitializedAsync() => _settings = await Queries.GetCompanySettingsAsync();
}
