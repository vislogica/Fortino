@page "/customers"
@using Fortino.Web.Chapters.Ch01
@inject Fortino.Web.Chapters.Ch01.Vulnerable.CustomerListReader VulnerableReader
@inject Fortino.Web.Chapters.Ch01.Secure.CustomerListReader SecureReader

@* L'elenco dei clienti, riservato allo staff. Il menu mostra la voce "Clienti" solo allo staff;
   chi può davvero vedere l'elenco lo decide il codice che lo legge (caso 1.2 del Laboratorio). *@

<PageTitle>Clienti · Fortino</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Clienti</MudText>

@if (_result is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_result.AccessDenied)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <b>Accesso negato.</b> L'elenco dei clienti è riservato allo staff di Carta &amp; Co.
    </MudAlert>
}
else
{
    <MudDataGrid T="CustomerRow" Items="_result.Customers" Dense="true" Hover="true" Elevation="0" Outlined="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Ragione sociale" />
            <PropertyColumn Property="x => x.VatNumber" Title="Partita IVA" />
            <PropertyColumn Property="x => x.Address" Title="Indirizzo" />
            <PropertyColumn Property="x => x.Iban" Title="IBAN" />
            <TemplateColumn Title="Fido">
                <CellTemplate>@Labels.Money(context.Item.CreditLimit)</CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>

    @* L'importazione di un cliente da un file XML: è qui che si prova il caso 18.1 (XXE) del
       Laboratorio (capitolo 18). *@
    <MudPaper Outlined="true" Class="pa-4 mt-6" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-1">Importa un cliente da XML</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Il file arriva dal gestionale di un altro ufficio: il nome del cliente sta in <code>&lt;nome&gt;</code>.</MudText>
        @if (Imported is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">Cliente importato: ora è nell'elenco qui sopra.</MudAlert>
        }
        @if (ImportError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@ImportError</MudAlert>
        }
        <form method="post" enctype="multipart/form-data" action="/import/xml" class="d-flex align-end" style="gap:12px">
            <AntiforgeryToken />
            <input class="fortino-input" id="xml-file" name="file" type="file" accept=".xml" required />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">Importa</MudButton>
        </form>
    </MudPaper>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter] private LabTrialState Trial { get; set; } = default!;

    // Esito dell'importazione da XML (caso 18.1).
    [SupplyParameterFromQuery(Name = "importato")] public string? Imported { get; set; }
    [SupplyParameterFromQuery(Name = "errore-import")] public string? ImportError { get; set; }

    private CustomerListResult? _result;

    protected override async Task OnInitializedAsync()
    {
        ClaimsPrincipal user = (await AuthState).User;

        // Il Laboratorio decide quale versione del codice legge l'elenco (caso 1.2):
        // fuori da una prova è sempre quella corretta.
        CodeVariant variant = Trial.VariantFor(1, "function-level");
        if (variant == CodeVariant.Vulnerable)
        {
            _result = await VulnerableReader.ReadAsync(user);
        }
        else
        {
            _result = await SecureReader.ReadAsync(user);
        }
    }
}
