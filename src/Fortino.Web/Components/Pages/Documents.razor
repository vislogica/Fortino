@page "/documents"
@attribute [Authorize(Policy = Policies.Staff)]
@inject FortinoQueries Queries

<PageTitle>Documenti · Fortino</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Documenti</MudText>

@if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Nessun documento caricato. Upload e download si provano nei capitoli 9 e 10 del Laboratorio.
    </MudAlert>
}
else
{
    <MudDataGrid T="StoredDocument" Items="_items" Dense="true" Hover="true" Elevation="0" Outlined="true">
        <Columns>
            <PropertyColumn Property="x => x.OriginalName" Title="Nome" />
            <PropertyColumn Property="x => x.ContentType" Title="Tipo" />
            <PropertyColumn Property="x => x.Size" Title="Dimensione (byte)" />
            <TemplateColumn Title="Caricato il">
                <CellTemplate>@context.Item.UploadedAt.ToString("dd/MM/yyyy HH:mm")</CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@* Due controlli che il server fa prima di accettare un contenuto: sono qui che si provano i casi
   10.1 (immagine con dimensioni enormi) e 10.2 (espressione regolare lenta) del Laboratorio.
   Dopo il controllo il server torna qui con la misura dell'effetto nell'indirizzo. *@
<MudGrid Class="mt-6">
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-4" Style="height:100%">
            <MudText Typo="Typo.h6" Class="mb-1">Controlla un'immagine</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Prima di allegare un'immagine PNG, il server ne prepara l'anteprima.</MudText>
            @if (ImageBytes is not null)
            {
                <MudAlert Severity="@(ImageMb is not null ? Severity.Warning : ImageCheck == "Ok" ? Severity.Success : Severity.Error)" Dense="true" Class="mb-3">
                    @ImageMessage()
                </MudAlert>
            }
            <form method="post" enctype="multipart/form-data" action="/documents/check-image">
                <AntiforgeryToken />
                <input class="fortino-input" id="image" name="file" type="file" accept="image/png" required />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">Controlla l'immagine</MudButton>
            </form>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-4" Style="height:100%">
            <MudText Typo="Typo.h6" Class="mb-1">Controlla un testo</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Il controllo di formato usa l'espressione regolare <code>^(a+)+$</code> del capitolo 10:
                accetta solo testi fatti di lettere «a».
            </MudText>
            @if (TextOutcome is not null)
            {
                <MudAlert Severity="@(TextOutcome is "Valid" or "NotValid" ? Severity.Info : Severity.Error)" Dense="true" Class="mb-3">
                    @TextMessage()
                </MudAlert>
            }
            <form method="post" action="/notes/validate">
                <AntiforgeryToken />
                <input class="fortino-input" id="text" name="text" placeholder="per esempio aaaa" required />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">Controlla il testo</MudButton>
            </form>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Esito del controllo dell'immagine (caso 10.1).
    [SupplyParameterFromQuery(Name = "byte")] public string? ImageBytes { get; set; }
    [SupplyParameterFromQuery(Name = "larghezza")] public string? ImageWidth { get; set; }
    [SupplyParameterFromQuery(Name = "altezza")] public string? ImageHeight { get; set; }
    [SupplyParameterFromQuery(Name = "mb")] public string? ImageMb { get; set; }
    [SupplyParameterFromQuery(Name = "controllo")] public string? ImageCheck { get; set; }

    // Esito del controllo del testo (caso 10.2).
    [SupplyParameterFromQuery(Name = "caratteri")] public string? TextLength { get; set; }
    [SupplyParameterFromQuery(Name = "esito")] public string? TextOutcome { get; set; }

    // Tempo impiegato dal server, per tutti e due i controlli.
    [SupplyParameterFromQuery(Name = "ms")] public string? Milliseconds { get; set; }

    private IReadOnlyList<StoredDocument> _items = [];

    protected override async Task OnInitializedAsync() => _items = await Queries.GetDocumentsAsync();

    private string ImageMessage()
    {
        string declared = $"{ImageWidth} × {ImageHeight} pixel";
        if (ImageMb is not null)
            return $"Anteprima pronta. Il file pesa {ImageBytes} byte ma dichiara {declared}: il server ha preparato {ImageMb} MB di memoria.";
        return ImageCheck switch
        {
            "Ok" => $"Immagine accettata ({declared}).",
            "TooManyPixels" => $"Immagine rifiutata: dichiara {declared}, oltre il limite. Il server non ha preparato memoria.",
            "TooManyBytes" => "Immagine rifiutata: il file è troppo grande.",
            _ => "Immagine rifiutata: il file non è un PNG.",
        };
    }

    private string TextMessage() => TextOutcome switch
    {
        "Valid" => $"Testo di {TextLength} caratteri controllato in {Milliseconds} ms: valido.",
        "NotValid" => $"Testo di {TextLength} caratteri controllato in {Milliseconds} ms: non valido.",
        "TimedOut" => $"Testo rifiutato dopo {Milliseconds} ms: il controllo ha superato il tempo massimo.",
        "TooLong" => $"Testo rifiutato: è più lungo di {Fortino.Web.Chapters.Ch10.Secure.SafeTextValidator.MaxLength} caratteri.",
        _ => "Testo vuoto: niente da controllare.",
    };
}
