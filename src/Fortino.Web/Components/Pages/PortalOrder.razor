@page "/portal/orders/{OrderId:int}"
@attribute [Authorize(Policy = Policies.Customer)]
@using Fortino.Web.Chapters.Ch01
@inject Fortino.Web.Chapters.Ch01.Vulnerable.OrderDetailReader VulnerableReader
@inject Fortino.Web.Chapters.Ch01.Secure.OrderDetailReader SecureReader
@inject FortinoQueries Queries

@* Il dettaglio di un ordine nel portale clienti. Il numero dell'ordine arriva dall'indirizzo:
   è qui che si prova il caso 1.1 del Laboratorio (capitolo 1). *@

<PageTitle>Ordine · Fortino</PageTitle>
<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        <b>Ordine non trovato.</b> Controlla il numero dell'ordine o torna all'elenco dei tuoi ordini.
    </MudAlert>
}
else
{
    var (statusText, statusColor) = Labels.Order(_order.Status);
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h5">Ordine @_order.Number</MudText>
        <MudChip T="string" Size="Size.Small" Color="statusColor" Variant="Variant.Text" Class="ml-3">@statusText</MudChip>
    </div>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td style="width:160px"><b>Cliente</b></td><td>@_order.CustomerName</td></tr>
                <tr><td><b>Data</b></td><td>@_order.OrderDate.ToString("dd/MM/yyyy")</td></tr>
                <tr><td><b>Note</b></td><td>@(_order.Notes ?? "—")</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @* Finché l'ordine è in bozza, il cliente può scrivere una nota per Carta & Co. Nel caso 2.2
       del Laboratorio la nota contiene un comando per il browser di chi la legge. *@
    @if (_order.Status == OrderStatus.Draft)
    {
        @if (NoteResult == "salvata")
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">Nota salvata.</MudAlert>
        }
        else if (NoteResult == "rifiutata")
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">La nota non è stata salvata: l'ordine non è tuo o non è più in bozza.</MudAlert>
        }
        <form method="post" action="@($"/portal/orders/{_order.Id}/nota")" class="mb-4" style="max-width:640px">
            <AntiforgeryToken />
            <label for="notes" class="mud-typography-body2">Nota per Carta &amp; Co.</label>
            <textarea class="fortino-input" id="notes" name="Notes" rows="3">@_order.Notes</textarea>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Salva la nota</MudButton>
        </form>
    }

    @* Finché l'ordine è in bozza, il cliente può aggiungere articoli. Il campo della quantità ha
       min="1": il browser non lascia inviare un numero più piccolo. Ma è un controllo del browser,
       e il browser è nelle mani dell'utente: è qui che si prova il caso 7.4 del Laboratorio (capitolo 7). *@
    @if (_order.Status == OrderStatus.Draft)
    {
        <ActionOutcome Outcome="@LineOutcome" Error="@LineError" SuccessText="Articolo aggiunto all'ordine." />
        <form method="post" action="@($"/portal/orders/{_order.Id}/righe")" class="d-flex align-end mb-4" style="gap:12px;max-width:720px">
            <AntiforgeryToken />
            <div style="flex:1">
                <label for="product" class="mud-typography-body2">Articolo</label>
                <select class="fortino-input" id="product" name="ProductId">
                    @foreach (var product in _products)
                    {
                        <option value="@product.Id">@product.Name (@Labels.Money(product.UnitPrice))</option>
                    }
                </select>
            </div>
            <div style="width:110px">
                <label for="quantity" class="mud-typography-body2">Quantità</label>
                <input class="fortino-input" id="quantity" name="Quantity" type="number" min="1" max="1000" value="1" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Aggiungi all'ordine</MudButton>
        </form>

        @* Il buono sconto, monouso: è qui che si prova il caso 16.1 del Laboratorio (capitolo 16). *@
        <div id="buono">
        @if (Coupon is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">Buono @Coupon applicato: lo sconto è nelle righe dell'ordine.</MudAlert>
        }
        @if (CouponError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@CouponError</MudAlert>
        }
        <form method="post" action="@($"/portal/orders/{_order.Id}/buono")" class="d-flex align-end mb-4" style="gap:12px;max-width:520px">
            <AntiforgeryToken />
            <div style="flex:1">
                <label for="coupon" class="mud-typography-body2">Buono sconto</label>
                <input class="fortino-input" id="coupon" name="Code" placeholder="per esempio BENVENUTO10" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">Applica il buono</MudButton>
        </form>
        </div>
    }

    <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
        <thead>
            <tr><th>Articolo</th><th style="text-align:right">Quantità</th><th style="text-align:right">Prezzo</th><th style="text-align:right">Importo</th></tr>
        </thead>
        <tbody>
            @foreach (var line in _order.Lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td style="text-align:right">@line.Quantity</td>
                    <td style="text-align:right">@Labels.Money(line.UnitPrice)</td>
                    <td style="text-align:right">@Labels.Money(line.Quantity * line.UnitPrice)</td>
                </tr>
            }
            <tr>
                <td colspan="3" style="text-align:right"><b>Totale</b></td>
                <td style="text-align:right"><b>@Labels.Money(_order.Total)</b></td>
            </tr>
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter] public int OrderId { get; set; }

    // Esito del salvataggio della nota, dopo il form: "salvata" o "rifiutata".
    [SupplyParameterFromQuery(Name = "nota")] public string? NoteResult { get; set; }

    // Esito del modulo «Aggiungi all'ordine».
    [SupplyParameterFromQuery(Name = "esito")] public string? LineOutcome { get; set; }
    [SupplyParameterFromQuery(Name = "errore")] public string? LineError { get; set; }
    // Il buono appena applicato (caso 16.1).
    [SupplyParameterFromQuery(Name = "buono")] public string? Coupon { get; set; }
    [SupplyParameterFromQuery(Name = "errore-buono")] public string? CouponError { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter] private LabTrialState Trial { get; set; } = default!;

    private OrderDetail? _order;
    private IReadOnlyList<Product> _products = [];
    private bool _loaded;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        _breadcrumbs = [new("I miei ordini", "/portal"), new("Dettaglio ordine", null, disabled: true)];
        ClaimsPrincipal user = (await AuthState).User;

        // Il Laboratorio decide quale versione del codice legge l'ordine (caso 1.1):
        // fuori da una prova è sempre quella corretta.
        CodeVariant variant = Trial.VariantFor(1, "idor");
        if (variant == CodeVariant.Vulnerable)
        {
            _order = await VulnerableReader.ReadAsync(OrderId, user);
        }
        else
        {
            _order = await SecureReader.ReadAsync(OrderId, user);
        }
        _products = await Queries.GetProductsAsync();
        _loaded = true;
    }
}
