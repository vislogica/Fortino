@page "/invoices/{InvoiceId:int}"
@attribute [Authorize(Policy = Policies.Staff)]
@inject FortinoQueries Queries
@inject IServiceProvider Services

@* Il documento di una fattura, come lo riceve il cliente. Intestatario, indirizzo e IBAN
   vengono dal documento costruito dal codice del capitolo 7 (caso 7.2 del Laboratorio). *@

<PageTitle>Fattura · Fortino</PageTitle>
<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_document is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        <b>Documento non disponibile.</b> La fattura non esiste oppure è ancora una bozza.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-4">Fattura @_document.Number</MudText>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td style="width:180px"><b>Data</b></td><td>@(_document.IssueDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                <tr><td><b>Intestatario</b></td><td>@_document.CustomerName</td></tr>
                <tr><td><b>Indirizzo</b></td><td>@_document.CustomerAddress</td></tr>
                <tr><td><b>IBAN su cui pagare</b></td><td><code>@_document.PaymentIban</code></td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
        <thead>
            <tr><th>Descrizione</th><th style="text-align:right">Quantità</th><th style="text-align:right">Prezzo</th><th style="text-align:right">Importo</th></tr>
        </thead>
        <tbody>
            @foreach (var line in _lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td style="text-align:right">@line.Quantity</td>
                    <td style="text-align:right">@Labels.Money(line.UnitPrice)</td>
                    <td style="text-align:right">@Labels.Money(line.Quantity * line.UnitPrice)</td>
                </tr>
            }
            <tr>
                <td colspan="3" style="text-align:right"><b>Totale</b></td>
                <td style="text-align:right"><b>@Labels.Money(_document.Total)</b></td>
            </tr>
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter] public int InvoiceId { get; set; }

    [CascadingParameter] private LabTrialState Trial { get; set; } = default!;

    private Fortino.Web.Chapters.Ch07.InvoiceDocument? _document;
    private IReadOnlyList<InvoiceLine> _lines = [];
    private bool _loaded;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        _breadcrumbs = [new("Fatture", "/invoices"), new("Documento", null, disabled: true)];

        // Il Laboratorio decide quale versione del codice costruisce il documento (caso 7.2):
        // fuori da una prova è sempre quella corretta.
        CodeVariant variant = Trial.VariantFor(7, "frozen-data");
        var documents = Services.GetRequiredKeyedService<Fortino.Web.Chapters.Ch07.IInvoiceService>(variant);
        _document = await documents.GetDocumentAsync(InvoiceId);
        if (_document is not null)
        {
            _lines = await Queries.GetInvoiceLinesAsync(InvoiceId);
        }
        _loaded = true;
    }
}
