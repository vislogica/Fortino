@page "/login"
@* Il campo nascosto ReturnUrl è il punto del caso 15.1 (open redirect): dopo l'accesso si torna lì. *@
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout

<PageTitle>Accesso · Fortino</PageTitle>

<div class="fortino-login">
    <MudPaper Class="pa-8" Elevation="2" Style="width:380px">
        <div class="d-flex align-center gap-2 mb-1">
            <img src="favicon.svg" alt="" width="28" height="28" />
            <MudText Typo="Typo.h5"><b>Fortino</b></MudText>
        </div>
        <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">Gestionale dimostrativo di Carta &amp; Co.</MudText>

        @if (_trialCase?.Trial is not null)
        {
            @* Prova a mano del Laboratorio: chi deve entrare e con quale versione del codice. *@
            <MudAlert Severity="@(_trialVulnerable ? Severity.Error : Severity.Success)" Dense="true" Class="mb-4">
                <b>Prova: @_trialCase.BookReference, @(_trialVulnerable ? "versione vulnerabile" : "versione corretta").</b><br />
                Entra come <code>@_trialCase.Trial.Username</code> (@_trialUserName), password <code>@SeedData.DemoPassword</code>.
            </MudAlert>
            @* Solo per il Laboratorio: le credenziali della prova sono già nei campi, per non riscriverle a
               ogni prova. In un programma vero non si fa mai. *@
            <MudText Typo="Typo.caption" Class="d-block mb-4 mud-text-secondary">
                Nome utente e password sono già scritti per comodità, perché nel Laboratorio entri molte volte;
                puoi cambiarli. In un programma vero sarebbe un errore grave: le credenziali non si
                preimpostano mai.
            </MudText>
        }

        @* Il testo è fisso: dall'indirizzo arriva solo un codice (capitolo 15). *@
        @if (Error == "2")
        {
            @* Caso 3.1: il nome utente è bloccato dopo troppi errori. *@
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                Troppi tentativi sbagliati con questo nome utente. Riprova tra 15 minuti.
            </MudAlert>
        }
        else if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">Nome utente o password non corretti.</MudAlert>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <label class="fortino-label" for="username">Nome utente</label>
            <input class="fortino-input" id="username" name="Username" autocomplete="username" required value="@_prefillUsername" />
            <label class="fortino-label" for="password">Password</label>
            <div class="fortino-password">
                <input class="fortino-input" id="password" name="Password" type="password" autocomplete="current-password" required value="@_prefillPassword" />
                @* L'occhio mostra o nasconde la password: cambia solo il tipo del campo, nel browser. *@
                <button type="button" class="fortino-password-eye" aria-label="Mostra o nascondi la password" title="Mostra o nascondi la password"
                        onclick="const p = document.getElementById('password'); p.type = p.type === 'password' ? 'text' : 'password'; this.classList.toggle('is-visible');">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 5c-5 0-9.3 3.1-11 7.5C2.7 16.9 7 20 12 20s9.3-3.1 11-7.5C21.3 8.1 17 5 12 5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
                </button>
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">
                Accedi
            </MudButton>
        </form>
        <MudLink Href="/password-dimenticata" Typo="Typo.body2" Class="d-block mt-3">Password dimenticata?</MudLink>

        <MudText Typo="Typo.caption" Class="mt-6 d-block mud-text-secondary">
            Utenti dimostrativi: anna, mario, verdi, lumen. La password è nel README del progetto.
        </MudText>
        <MudButton Href="/lab" Variant="Variant.Text" Size="Size.Small" Class="mt-2 px-0"
                   StartIcon="@Icons.Material.Outlined.Science">
            Torna al Laboratorio
        </MudButton>
    </MudPaper>
</div>

@inject LabRegistry Registry

@code {
    [CascadingParameter] private LabTrialState Trial { get; set; } = default!;

    private ILabCase? _trialCase;
    private bool _trialVulnerable;
    private string _trialUserName = "";
    // Solo durante una prova del Laboratorio: le credenziali indicate dalla prova, già nei campi.
    private string? _prefillUsername;
    private string? _prefillPassword;

    protected override void OnParametersSet()
    {
        var current = Trial?.Current;
        if (current is null) return;
        _trialCase = Registry.Find(current.Chapter, current.CaseSlug);
        _trialVulnerable = current.Variant == CodeVariant.Vulnerable;
        var username = _trialCase?.Trial?.Username;
        _trialUserName = SeedData.Users.Where(u => u.Username == username).Select(u => u.DisplayName).FirstOrDefault() ?? "";
        if (username is not null)
        {
            _prefillUsername = username;
            _prefillPassword = SeedData.DemoPassword;
        }
    }

    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

}
