@page "/password-dimenticata"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout

@* «Password dimenticata?»: si chiede l'email con il link per reimpostare la password. Il link lo
   costruisce il codice del caso 15.2 del Laboratorio (capitolo 15). *@

<PageTitle>Password dimenticata · Fortino</PageTitle>

<div class="fortino-login">
    <MudPaper Class="pa-8" Elevation="2" Style="width:380px">
        <MudText Typo="Typo.h5" Class="mb-1"><b>Password dimenticata</b></MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Ti mandiamo un'email con il link per sceglierne una nuova.</MudText>
        @if (Sent is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">
                Se il nome utente esiste, l'email è partita. Controlla la tua posta.
            </MudAlert>
        }
        <form method="post" action="/forgot-password">
            <label class="fortino-label" for="username">Nome utente</label>
            <input class="fortino-input" id="username" name="Username" required />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">
                Mandami il link
            </MudButton>
        </form>
        <MudButton Href="/login" Variant="Variant.Text" Size="Size.Small" Class="mt-4 px-0">Torna all'accesso</MudButton>
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "inviata")] public string? Sent { get; set; }
}
