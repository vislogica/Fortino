<CascadingValue Value="_trial" IsFixed="true">
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="ma-6">
                    Questa pagina non è disponibile per il tuo ruolo. Usa "Entra come…" in alto a destra per cambiare utente.
                </MudAlert>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <MudText Typo="Typo.h5" Class="ma-6">Pagina non trovata.</MudText>
        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>

@code {
    // Il cookie della prova a mano in corso (vedi App.razor): diventa un valore a cascata che
    // ogni pagina può leggere per scegliere la versione del codice.
    [Parameter] public string? TrialCookie { get; set; }

    private LabTrialState _trial = new(null);

    protected override void OnParametersSet() => _trial = new LabTrialState(ActiveTrial.Parse(TrialCookie));
}
