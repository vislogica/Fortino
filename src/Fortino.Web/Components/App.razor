<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <title>Fortino · Carta &amp; Co.</title>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" TrialCookie="@_trialCookie" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["lab/ch11.js"]"></script>
    <script src="@Assets["lab/ch13.js"]"></script>
    <script src="@Assets["lab/ch17.js"]"></script>
</body>

</html>

@code {
    // Disponibile solo durante il primo disegno sul server, non nel circuito interattivo:
    // per questo il cookie della prova si legge qui e si passa a Routes come parametro.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? _trialCookie;

    protected override void OnInitialized() =>
        _trialCookie = HttpContext?.Request.Cookies[ActiveTrial.CookieName];
}
