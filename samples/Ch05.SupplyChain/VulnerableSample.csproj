<Project Sdk="Microsoft.NET.Sdk">

  <!-- Progetto di esempio del capitolo 5 (supply chain). Usa DI PROPOSITO un pacchetto vecchio
       con una vulnerabilita' nota, per far vedere come il comando di controllo la scopre.
       NON fa parte dell'applicazione Fortino e non va usato in produzione: e' tenuto separato apposta. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Non trattare gli avvisi di vulnerabilità come errori qui: vogliamo poterli vedere.
         NU1510 silenziato perché qui vogliamo di proposito un riferimento esplicito al pacchetto. -->
    <NoWarn>NU1900;NU1901;NU1902;NU1903;NU1904;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versione vecchia, con una vulnerabilità nota (CVE-2021-26701). La versione corretta è la più recente. -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.7.1" />
  </ItemGroup>

</Project>
